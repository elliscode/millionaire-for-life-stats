{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudFrontReadsSiteOnly",
      "Effect": "Allow",
      "Principal": { "Service": "cloudfront.amazonaws.com" },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::m4l-elliscode-com/site/*",
      "Condition": {
        "StringEquals": { "AWS:SourceArn": "arn:aws:cloudfront::ACCOUNT_ID:distribution/DISTRIBUTION_ID" }
      }
    }
  ]
}
