{
 "_comment": "Shared by tests/test_ticket_checker.py (Python), tests/js/checker.test.mjs (browser logic in Node), and tests/js/browser-smoke.mjs (real UI, uiCases only). Synthetic drawing for unit cases; uiCases use the real 2026-08-06 drawing (7 20 42 48 51, Millionaire Ball 3).",
 "drawing": {"date": "2026-01-01", "winningNumbers": [1, 2, 3, 4, 5], "millionaireBall": 1,
             "prizes": ["$18,000,000", "$2,200,000", "$7,500", "$500", "$250", "$50", "$25", "$8", "$8"]},
 "cases": [
  {"name": "5 + MB (top prize)",      "whites": [1, 2, 3, 4, 5],     "mb": 1, "tier": "m5-mb", "lifetime": "top"},
  {"name": "5 + MB, any order",       "whites": [5, 3, 1, 4, 2],     "mb": 1, "tier": "m5-mb", "lifetime": "top"},
  {"name": "5 white (second prize)",  "whites": [1, 2, 3, 4, 5],     "mb": 2, "tier": "m5",    "lifetime": "second"},
  {"name": "4 + MB",                  "whites": [1, 2, 3, 4, 58],    "mb": 1, "tier": "m4-mb", "prize": "$7,500"},
  {"name": "4 white",                 "whites": [1, 2, 3, 4, 58],    "mb": 5, "tier": "m4",    "prize": "$500"},
  {"name": "3 + MB",                  "whites": [1, 2, 3, 57, 58],   "mb": 1, "tier": "m3-mb", "prize": "$250"},
  {"name": "3 white",                 "whites": [1, 2, 3, 57, 58],   "mb": 4, "tier": "m3",    "prize": "$50"},
  {"name": "2 + MB",                  "whites": [1, 2, 56, 57, 58],  "mb": 1, "tier": "m2-mb", "prize": "$25"},
  {"name": "2 white",                 "whites": [1, 2, 56, 57, 58],  "mb": 3, "tier": "m2",    "prize": "$8"},
  {"name": "1 + MB",                  "whites": [1, 55, 56, 57, 58], "mb": 1, "tier": "m1-mb", "prize": "$8"},
  {"name": "1 white only: no prize",  "whites": [1, 55, 56, 57, 58], "mb": 2, "tier": null},
  {"name": "MB only: no prize",       "whites": [54, 55, 56, 57, 58],"mb": 1, "tier": null},
  {"name": "nothing: no prize",       "whites": [54, 55, 56, 57, 58],"mb": 2, "tier": null},
  {"name": "white ball 59",           "whites": [1, 2, 3, 4, 59],    "mb": 1, "error": "from 1 to 58"},
  {"name": "white ball 0",            "whites": [0, 2, 3, 4, 5],     "mb": 1, "error": "from 1 to 58"},
  {"name": "non-integer white",       "whites": [1.5, 2, 3, 4, 5],   "mb": 1, "error": "from 1 to 58"},
  {"name": "duplicate whites",        "whites": [1, 1, 3, 4, 5],     "mb": 1, "error": "all be different"},
  {"name": "only four whites",        "whites": [1, 2, 3, 4],        "mb": 1, "error": "exactly 5"},
  {"name": "Millionaire Ball 6",      "whites": [1, 2, 3, 4, 5],     "mb": 6, "error": "from 1 to 5"},
  {"name": "Millionaire Ball 0",      "whites": [1, 2, 3, 4, 5],     "mb": 0, "error": "from 1 to 5"},
  {"name": "invalid date",            "whites": [1, 2, 3, 4, 5],     "mb": 1, "date": "2026-13-45", "error": "valid drawing date"},
  {"name": "no result for date",      "whites": [1, 2, 3, 4, 5],     "mb": 1, "date": "2026-01-02", "error": "No verified result"}
 ],
 "uiCases": [
  {"name": "real top-prize combination", "date": "2026-08-06", "whites": [51, 48, 42, 20, 7], "mb": 3, "expectText": "TOP PRIZE"},
  {"name": "real second-prize combination", "date": "2026-08-06", "whites": [7, 20, 42, 48, 51], "mb": 1, "expectText": "SECOND PRIZE"},
  {"name": "real 3 + MB", "date": "2026-08-06", "whites": [7, 20, 42, 1, 2], "mb": 3, "expectText": "Matching combination: 3 + Millionaire Ball"},
  {"name": "real no prize", "date": "2026-08-06", "whites": [1, 2, 3, 4, 5], "mb": 1, "expectText": "No matching prize combination"},
  {"name": "duplicate numbers rejected", "date": "2026-08-06", "whites": [7, 7, 42, 48, 51], "mb": 3, "expectText": "all be different"},
  {"name": "out of range rejected", "date": "2026-08-06", "whites": [7, 20, 42, 48, 59], "mb": 3, "expectText": "from 1 to 58"},
  {"name": "pre-launch date rejected", "date": "2026-01-15", "whites": [7, 20, 42, 48, 51], "mb": 3, "expectText": "No verified result"}
 ]
}
